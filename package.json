  "description": "Optimized Proxy server for MyAnime streaming with CORS, Referer header support, and caching",
  "main": "proxy-server.js",
  "scripts": {
    "start": "node proxy-server.js",
    "dev": "nodemon proxy-server.js"
  },
  "engines": {
