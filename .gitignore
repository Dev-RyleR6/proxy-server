# =========================
# Node.js / Express ignore
# =========================

# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
debug.log

# OS generated files
.DS_Store
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp

# Build / dist output
dist/
build/
out/
tmp/
temp/

# Cache
.cache/
.eslintcache

# Coverage / test reports
coverage/
*.lcov

# Local environment files (sensitive)
*.local.json

# Optional lock files (uncomment if you don’t want to track them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Misc
*.pid
*.seed
*.pid.lock
